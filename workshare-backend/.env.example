# ─── WorkShare Backend ───
# Copy this file to .env and fill in your values

# Server
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://admin:admin123@localhost:27017/workshare

# JWT used for signed login tokens
JWT_SECRET=replace-with-a-long-random-secret

# Gmail SMTP credentials for OTP delivery (local dev fallback)
EMAIL_USER=your-workshare-email@gmail.com
EMAIL_PASS=your-app-password

# Resend API (used in production — works on Render/Vercel)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-api-key-here
